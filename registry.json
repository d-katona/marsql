{
    "$schema": "https://ui.shadcn.com/schema/registry.json",
    "name": "ui",
    "homepage": "https://github.com/d-katona/marsql",
    "include": [
        "src/marsql/registry.json",
        "src/marsql/form/registry.json",
        "src/marsql/layout/registry.json",
        "src/marsql/hooks/registry.json",
        "src/marsql/client/registry.json",
        "src/marsql/api/registry.json"
    ],
    "items": [
        {
            "name": "basic",
            "type": "registry:block",
            "registryDependencies": [
                "button",
                "input",
                "input-group",
                "field",
                "calendar",
                "popover",
                "textarea",
                "checkbox",
                "switch",
                "combobox",
                "separator",
                "table",
                "sonner",
                "dialog"
            ]
        },
        {
            "name": "own",
            "type": "registry:block",
            "registryDependencies": [
                "d-katona/marsql/useStyle",
                "d-katona/marsql/calendar",
                "d-katona/marsql/checkbox",
                "d-katona/marsql/combobox",
                "d-katona/marsql/form-styles",
                "d-katona/marsql/form",
                "d-katona/marsql/input",
                "d-katona/marsql/submit",
                "d-katona/marsql/switch",
                "d-katona/marsql/textarea",
                "d-katona/marsql/actions",
                "d-katona/marsql/block",
                "d-katona/marsql/container",
                "d-katona/marsql/sticky",
                "d-katona/marsql/table-index",
                "d-katona/marsql/title",
                "d-katona/marsql/use-debounce",
                "d-katona/marsql/use-debounce-form",
                "d-katona/marsql/use-submit",
                "d-katona/marsql/use-navigation",
                "d-katona/marsql/use-record",
                "d-katona/marsql/use-session-storage",
                "d-katona/marsql/http",
                "d-katona/marsql/styles",
                "d-katona/marsql/readme",
                "d-katona/marsql/with-user"
            ]
        },
        {
            "name": "all",
            "type": "registry:block",
            "registryDependencies": [
                "d-katona/marsql/basic",
                "d-katona/marsql/own"
            ]
        }
    ]
}